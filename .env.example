# CoatiPay — SDK de Python
# ═══════════════════════════════════════════════════════════════
# Copia a .env y rellena con tus claves del dashboard.
#
#   cp .env.example .env
#
# El SDK NO lee estas variables por su cuenta: se las pasas tú al
# construir el cliente. Están aquí para fijar la convención de nombres
# y que los ejemplos del README funcionen tal cual.
#
#   relay = CoatiPay(api_key=os.environ["COATIPAY_SECRET_KEY"])
# ═══════════════════════════════════════════════════════════════

# ⚠️ Clave SECRETA — SOLO en tu backend, NUNCA en el navegador.
# La obtienes en el dashboard, sección Claves. Usa sk_test_ para probar.
COATIPAY_SECRET_KEY=sk_test_

# Secreto para verificar la firma de los webhooks. Se muestra UNA sola
# vez al registrar el endpoint — si lo pierdes, registra otro.
# Verifica siempre la cabecera `X-Signature` antes de dar un pago por bueno.
COATIPAY_WEBHOOK_SECRET=whsec_

# Host del API. Opcional: el SDK ya apunta aquí por defecto.
# Cámbialo solo si corres tu propia instancia.
# COATIPAY_BASE_URL=https://api.coatipay.com
